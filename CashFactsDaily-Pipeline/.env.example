# CashFactsDaily Pipeline — Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control!

# DeepSeek API (for script generation)
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# --- Phase 2+ Keys (fill in later) ---

# ElevenLabs (for TTS voice generation)
# ELEVENLABS_API_KEY=

# HeyGen (for avatar video generation)
# HEYGEN_API_KEY=

# Ideogram (for thumbnail generation)
# IDEOGRAM_API_KEY=

# Facebook Graph API (for auto-posting)
# FB_PAGE_ACCESS_TOKEN_EN=
# FB_PAGE_ACCESS_TOKEN_ID=
# FB_PAGE_ID_EN=
# FB_PAGE_ID_ID=

# YouTube Data API (for auto-upload)
# YOUTUBE_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
